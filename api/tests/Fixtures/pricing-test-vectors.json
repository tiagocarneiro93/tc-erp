            { "type": "percentage", "value": "5.00" }
          ] }
        ]
      },
      "expected": {
        "lines": [
          { "line_amount_before_discounts": "100.000000", "discount_amount": "14.500000", "settlement_amount": "0.000000", "net_amount": "85.50", "gross_amount": "105.17", "tax_amount": "19.67", "tax_region": "PT", "tax_code": "NOR", "tax_percentage": "23.00" }
