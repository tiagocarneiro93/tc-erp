    {
      "name": "global-discount-with-line-discounts",
      "notes": "Replaces the old 'global-discount-largest-remainder' vector, which didn't actually exercise remainder distribution: with clean 2dp line amounts and no line-level discount, a percentage global discount's exact per-line share (amount × rate) always terminates within 4 decimals, so at 6dp there is never a remainder to distribute — the old vector passed even with the redistribution logic deleted entirely. Here each line first takes a 33.33% line-level discount (100.00/50.00/75.00 → 66.673300/33.335000/50.002500, i.e. non-2dp amounts), THEN a 12.34% global discount is allocated across those — this genuinely produces a sub-6dp remainder that must be redistributed by largest-remainder for the three settlement_amounts (8.227078 + 4.113539 + 6.170309 = 18.510926) to sum exactly to the line-precision-rounded discount total. Also closes the coverage gap of no vector combining a global discount with line-level discounts (§7.9.4 step ordering: line discounts, then global discount, then VAT last).",
      "input": {
        "pricing_mode": "net",
        "rounding_method": "per_line",
        "date": "2026-01-01",
        "global_discount_percent": "12.34",
        "lines": [
          { "quantity": "1", "unit_price": "100.00", "tax_region": "PT", "tax_code": "NOR", "discounts": [
            { "type": "percentage", "value": "33.33" }
          ] },
          { "quantity": "1", "unit_price": "50.00", "tax_region": "PT", "tax_code": "NOR", "discounts": [
            { "type": "percentage", "value": "33.33" }
          ] },
          { "quantity": "1", "unit_price": "75.00", "tax_region": "PT", "tax_code": "NOR", "discounts": [
            { "type": "percentage", "value": "33.33" }
          ] }
        ]
      },
      "expected": {
        "lines": [
          { "line_amount_before_discounts": "100.000000", "discount_amount": "33.330000", "settlement_amount": "8.227078", "net_amount": "58.44", "gross_amount": "71.88", "tax_amount": "13.44", "tax_region": "PT", "tax_code": "NOR", "tax_percentage": "23.00" },
          { "line_amount_before_discounts": "50.000000", "discount_amount": "16.665000", "settlement_amount": "4.113539", "net_amount": "29.22", "gross_amount": "35.94", "tax_amount": "6.72", "tax_region": "PT", "tax_code": "NOR", "tax_percentage": "23.00" },
          { "line_amount_before_discounts": "75.000000", "discount_amount": "24.997500", "settlement_amount": "6.170309", "net_amount": "43.83", "gross_amount": "53.91", "tax_amount": "10.08", "tax_region": "PT", "tax_code": "NOR", "tax_percentage": "23.00" }
        ],
        "tax_summary": [
          { "tax_region": "PT", "tax_code": "NOR", "tax_percentage": "23.00", "taxable_base": "131.49", "tax_amount": "30.24" }
        ],
        "net_total": "131.49",
        "tax_total": "30.24",
        "gross_total": "161.73"
      }
    },
