          { "line_amount_before_discounts": "50.000000", "discount_amount": "0.000000", "settlement_amount": "0.000000", "net_amount": "50.00", "gross_amount": "53.00", "tax_amount": "3.00", "tax_region": "PT", "tax_code": "RED", "tax_percentage": "6.00" }
