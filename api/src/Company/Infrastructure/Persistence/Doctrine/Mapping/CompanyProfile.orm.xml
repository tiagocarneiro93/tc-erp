<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                                       https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <entity name="App\Company\Domain\CompanyProfile" table="company_profile">
        <id name="companyId" type="company_id" column="company_id">
            <generator strategy="NONE" />
        </id>

        <field name="nif" type="nif" column="nif" />
        <field name="legalName" type="string" column="legal_name" />
        <field name="commercialName" type="string" column="commercial_name" nullable="true" />
        <field name="address" type="string" column="address" nullable="true" />
        <field name="postalCode" type="string" column="postal_code" nullable="true" />
        <field name="city" type="string" column="city" nullable="true" />
        <field name="country" type="string" column="country" />
        <field name="shareCapital" type="money" column="share_capital" nullable="true" />
        <field name="registryOffice" type="string" column="registry_office" nullable="true" />
        <field name="email" type="string" column="email" nullable="true" />
        <field name="phone" type="string" column="phone" nullable="true" />
        <field name="logoKey" type="string" column="logo_key" nullable="true" />
        <field name="fiscalRegion" type="string" column="fiscal_region" />
        <field name="vatRegime" type="string" column="vat_regime" />
        <field name="cashVat" type="boolean" column="cash_vat" />
    </entity>
</doctrine-mapping>
