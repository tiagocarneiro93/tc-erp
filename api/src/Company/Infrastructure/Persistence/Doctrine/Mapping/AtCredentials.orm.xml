<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                                       https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <entity name="App\Company\Domain\AtCredentials" table="at_credentials">
        <id name="companyId" type="company_id" column="company_id">
            <generator strategy="NONE" />
        </id>

        <field name="subuser" type="string" column="subuser" />
        <field name="passwordEncrypted" type="text" column="password_encrypted" />
        <field name="validatedAt" type="datetimetz_immutable" column="validated_at" nullable="true" />
        <field name="lastError" type="string" column="last_error" nullable="true" />
    </entity>
</doctrine-mapping>
