<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                                       https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <entity name="App\Platform\Domain\User" table="users">
        <id name="id" type="user_id" column="id">
            <generator strategy="NONE" />
        </id>

        <field name="email" type="string" column="email" unique="true" />
        <field name="name" type="string" column="name" />
        <field name="passwordHash" type="string" column="password_hash" />
        <field name="mustChangePassword" type="boolean" column="must_change_password" />
        <field name="passwordChangedAt" type="datetimetz_immutable" column="password_changed_at" nullable="true" />
        <field name="mfaSecret" type="string" column="mfa_secret" nullable="true" />
        <field name="status" type="string" column="status" />
        <field name="createdAt" type="datetimetz_immutable" column="created_at" />
    </entity>
</doctrine-mapping>
