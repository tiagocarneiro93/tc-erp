<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                                       https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <entity name="App\Fiscal\Domain\DocumentDraft" table="document_drafts">
        <id name="id" type="document_draft_id" column="id">
            <generator strategy="NONE" />
        </id>

        <field name="companyId" type="company_id" column="company_id" />
        <field name="documentType" type="string" column="document_type" />
        <field name="payload" type="jsonb" column="payload" />
        <field name="seriesId" type="string" column="series_id" nullable="true" />
        <field name="customerId" type="string" column="customer_id" nullable="true" />
        <field name="calculated" type="jsonb" column="calculated" nullable="true" />
        <field name="createdBy" type="string" column="created_by" />
        <field name="updatedAt" type="datetimetz_immutable" column="updated_at" />

        <indexes>
            <index name="idx_document_drafts_company_updated" columns="company_id,updated_at" />
        </indexes>
    </entity>
</doctrine-mapping>
