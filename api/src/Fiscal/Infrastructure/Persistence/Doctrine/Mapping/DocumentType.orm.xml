<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                                       https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <entity name="App\Fiscal\Domain\DocumentType" table="document_types">
        <id name="code" type="string" column="code">
            <generator strategy="NONE" />
        </id>

        <field name="saftSection" type="string" column="saft_section" />
        <field name="signed" type="boolean" column="signed" />
        <field name="stockEffect" type="string" column="stock_effect" />
        <field name="accountEffect" type="string" column="account_effect" />
        <field name="requiresAtPriorCommunication" type="boolean" column="requires_at_prior_communication" />
    </entity>
</doctrine-mapping>
