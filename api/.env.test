# Committed environment-specific defaults for APP_ENV=test (see .env).
# Points at the dedicated test database created by docker/postgres/init/02-databases.sql,
# with the same app_owner/app_runtime role split as dev (CLAUDE.md — never SQLite for
# integration tests).
DATABASE_URL="postgresql://app_runtime:app_runtime@127.0.0.1:5432/tc_erp_test?serverVersion=16&charset=utf8"
DATABASE_MIGRATIONS_URL="postgresql://app_owner:app_owner@127.0.0.1:5432/tc_erp_test?serverVersion=16&charset=utf8"
