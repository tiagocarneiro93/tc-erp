# In all environments, the following files are loaded if they exist,
# the latter taking precedence over the former:
#
#  * .env                contains default values for the environment variables needed by the app
#  * .env.local          uncommitted file with local overrides
#  * .env.$APP_ENV       committed environment-specific defaults
#  * .env.$APP_ENV.local uncommitted environment-specific overrides
#
# Real environment variables win over .env files.
#
# DO NOT DEFINE PRODUCTION SECRETS IN THIS FILE NOR IN ANY OTHER COMMITTED FILES.
# https://symfony.com/doc/current/configuration/secrets.html
#
# Run "composer dump-env prod" to compile .env files for production use (requires symfony/flex >=1.2).
# https://symfony.com/doc/current/best_practices.html#use-environment-variables-for-infrastructure-configuration

###> symfony/framework-bundle ###
APP_ENV=dev
# Dev-only default, not a production secret; production overrides this via a
# real secret (CLAUDE.md — secrets are never committed for real environments).
APP_SECRET=6c16909702e7cb10f434cc86b4a17625
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> symfony/routing ###
# Configure how to generate URLs in non-HTTP contexts, such as CLI commands.
# See https://symfony.com/doc/current/routing.html#generating-urls-in-commands
DEFAULT_URI=http://localhost
###< symfony/routing ###

###> symfony/mailer ###
MAILER_DSN=smtp://127.0.0.1:1025
MAILER_FROM_ADDRESS=no-reply@tc-erp.example
###< symfony/mailer ###

###> tc-erp ###
# Where the SPA lives, for links in emails (e.g. the password reset link).
# task 0.13 builds the actual web app; Vite's default dev port for now.
FRONTEND_URL=http://localhost:5173

# Dev-only default (libsodium secretbox key, base64, 32 bytes) for
# encrypting AT credentials at rest (technical-scope.md §8.2); production
# overrides this via a real secrets-manager value, same treatment as
# APP_SECRET above (CLAUDE.md — secrets are never committed for real
# environments). Not a production secret: generated once for this repo.
AT_CREDENTIALS_ENCRYPTION_KEY=AuVsFHGzoymbeNxc0R/5Nzn3cXljZ5byqND5Vp+Y0xE=

# Despacho 8632/2014 §2.1.1/§6.2: document signing. Only the path, key
# version and certificate number are committed — the private key *file*
# itself is git-ignored (`/var/`) and generated locally with `make
# signing-key` (tests/bootstrap.php generates one on the fly if missing).
# 0000 is AT's own placeholder certificate number for testing/examples
# throughout Despacho 8632/2014 and Portaria 195/2020 — not a real one.
DOCUMENT_SIGNING_KEY_PATH=var/signing/document-signing-dev.pem
DOCUMENT_SIGNING_KEY_VERSION=1
DOCUMENT_SIGNING_CERTIFICATE_NUMBER=0000

# docs/plans/phase-3.md task 3.1: AT webservice clients. The two files
# themselves are never committed — under var/ (already .gitignore'd
# wholesale, same treatment as the signing key above), not the repo-root
# docker/keys/ this originally used: that path resolves relative to
# %kernel.project_dir% (i.e. /app in the php container), and docker/keys/
# is a sibling of api/, so it was never actually mounted in — the exact
# trap task 2.5's docblock already flagged when choosing var/signing/ for
# the same reason. Only the paths, and for the public key the fact that
# it's public, are committed here. The client cert's own unlock password
# is not committed either, even though it travels with an already-gitignored
# file, since it's part of the same credential bundle; set it in .env.local
# for `make up`/dev use. Endpoints default to AT's *test* environment
# (at-ws-efatura-aspetos-genericos.pdf / at-ws-series-aspetos-especificos.pdf
# §1.2.2) — switching to production is a later, separate config change
# (§14.3 item 23, hosting).
AT_PUBLIC_KEY_PATH=var/at-webservices/at-public-key.cer
AT_WEBSERVICES_CLIENT_CERT_PATH=var/at-webservices/TesteWebservices.pfx
AT_WEBSERVICES_CLIENT_CERT_PASSWORD=
AT_EFATURA_WEBSERVICE_ENDPOINT=https://servicos.portaldasfinancas.gov.pt:723/fatcorews/ws/
AT_SERIES_WEBSERVICE_ENDPOINT=https://servicos.portaldasfinancas.gov.pt:722/SeriesWSService

# Live-AT-test-environment integration tests (docs/plans/phase-3.md task
# 3.1g) only run when both are set — see AtIntegration's own test helper,
# which calls markTestSkipped() otherwise. Left blank here on purpose; set
# real values in **.env.test.local**, not .env.local — Symfony's Dotenv
# deliberately ignores .env.local under APP_ENV=test ("tests should produce
# the same results for everyone"), only .env.test.local is loaded there,
# and PHPUnit always runs under APP_ENV=test. Never commit an AT sub-user's
# actual login password.
AT_TEST_SUBUSER=
AT_TEST_PASSWORD=
###< tc-erp ###

###> sentry/sentry-symfony ###
# technical-scope.md §10.2. Blank means the SDK sends nothing (config/packages/sentry.yaml).
# Real value goes in .env.local (a write-only per-project ingestion key from
# sentry.io, not a login credential, but still not committed — same
# treatment as every other optional secret here).
SENTRY_DSN=
###< sentry/sentry-symfony ###

###> symfony/messenger ###
# Async transport lives on Redis (task 0.5); sync buses need no transport.
MESSENGER_TRANSPORT_DSN=redis://127.0.0.1:6379/messages
###< symfony/messenger ###

###> doctrine/doctrine-bundle ###
# DATABASE_URL: the app connects as app_runtime (no table ownership, no
# BYPASSRLS). DATABASE_MIGRATIONS_URL: migrations run as app_owner. Passwords
# below are the throwaway dev-only values from docker/postgres/init/01-roles.sql.
DATABASE_URL="postgresql://app_runtime:app_runtime@127.0.0.1:5432/tc_erp?serverVersion=16&charset=utf8"
DATABASE_MIGRATIONS_URL="postgresql://app_owner:app_owner@127.0.0.1:5432/tc_erp?serverVersion=16&charset=utf8"
###< doctrine/doctrine-bundle ###

###> redis (health check, cache) ###
REDIS_URL=redis://127.0.0.1:6379
###< redis (health check, cache) ###
