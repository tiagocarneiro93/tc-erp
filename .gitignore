# Environment — .env and .env.<APP_ENV> hold committed dev-only defaults
# (Symfony convention); only the .local overrides are actual secrets.
.env.local
.env.*.local

# PHP / Symfony
/api/vendor/
/api/var/
/api/.phpunit.cache/
/api/public/bundles/

# Node / web
/web/node_modules/
/web/dist/
/web/coverage/
/web/.vite/

# Secrets / keys — never commit the signing key (CLAUDE.md — hard rules)
*.pem
*.key
docker/keys/

# IDE / OS
.idea/
.vscode/
.DS_Store
Thumbs.db

# Logs
*.log
